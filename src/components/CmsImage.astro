---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { resolveImage } from "../lib/images";

interface Props {
  src?: string | null;
  alt: string;
  class?: string;
  widths?: number[];
  sizes?: string;
  loading?: "lazy" | "eager";
  fetchpriority?: "high" | "low" | "auto";
  width?: number;
  height?: number;
}

const {
  src,
  alt,
  class: className,
  widths,
  sizes,
  loading = "lazy",
  fetchpriority,
  width,
  height,
} = Astro.props;

const resolved = resolveImage(src);
const meta = typeof resolved === "object" ? (resolved as ImageMetadata) : null;
const isSvg = meta?.format === "svg";
---

{
  meta && !isSvg && (
    <Image
      src={meta}
      alt={alt}
      class={className}
      widths={widths}
      sizes={sizes}
      loading={loading}
      fetchpriority={fetchpriority}
    />
  )
}
{
  meta && isSvg && (
    <img
      src={meta.src}
      alt={alt}
      class={className}
      width={meta.width}
      height={meta.height}
      loading={loading}
    />
  )
}
{
  !meta && resolved && (
    <img
      src={resolved as string}
      alt={alt}
      class={className}
      width={width}
      height={height}
      loading={loading}
    />
  )
}
{!resolved && <slot name="fallback" />}
